{
  "name": "object-pools",
  "version": "0.1.0",
  "description": "Lightweight TypeScript library for managing data collections with filters, sorting, and composition",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "knip": "knip",
    "check": "npm run build && npm run knip && npm run typecheck && npm run lint && npm run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "example:basic": "tsx examples/basic.ts",
    "example:proxy-pool": "tsx examples/proxy-pool.ts",
    "example:map-like": "tsx examples/map-like.ts",
    "example:game-service": "tsx examples/game-service.ts",
    "example:iteration": "tsx examples/iteration.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.0.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "pool",
    "collection",
    "filter",
    "query",
    "typescript"
  ]
}
